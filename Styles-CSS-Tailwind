body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #2f3136; color: #dcddde; margin: 0; }
.app-container { display: flex; height: 100vh; }
.sidebar { width: 260px; background: #2b2d31; padding: 20px; border-right: 1px solid #1e1f22; }
.chat-window { flex: 1; display: flex; flex-direction: column; }
.chat-header { padding: 15px 20px; background: #2f3136; border-bottom: 1px solid #1e1f22; box-shadow: 0 1px 2px rgba(0,0,0,0.2); }
.message-list { padding: 20px; overflow-y: auto; }
.message { margin-bottom: 15px; border-left: 3px solid #5865f2; padding-left: 10px; }
.timestamp { font-size: 0.75rem; color: #949ba4; display: block; }
.user { font-weight: bold; color: #fff; margin-right: 10px; }
.admin { color: #00aff4; }
.text { margin-top: 5px; line-height: 1.4; }
