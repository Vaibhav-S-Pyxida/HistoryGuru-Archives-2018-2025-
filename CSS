:root {
    --bg-main: #111b21;
    --bg-sidebar: #202c33;
    --incoming-msg: #202c33;
    --outgoing-msg: #005c4b;
    --text-primary: #e9edef;
    --text-secondary: #8696a0;
    --accent: #00a884;
}

body { font-family: 'Segoe UI', Helvetica, Arial, sans-serif; background-color: var(--bg-main); color: var(--text-primary); margin: 0; display: flex; height: 100vh; }
.sidebar { width: 30%; background: var(--bg-sidebar); border-right: 1px solid #3b4a54; padding: 20px; overflow-y: auto; }
.chat-area { flex: 1; display: flex; flex-direction: column; background: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png'); background-repeat: repeat; }

.messages-container { flex: 1; overflow-y: auto; padding: 20px 5%; display: flex; flex-direction: column; }
.date-badge { align-self: center; background: #182229; padding: 5px 12px; border-radius: 8px; font-size: 0.8rem; color: var(--text-secondary); margin: 20px 0; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); }

.msg { max-width: 65%; padding: 8px 10px; border-radius: 8px; margin-bottom: 4px; position: relative; font-size: 0.95rem; line-height: 1.4; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); }
.msg.received { align-self: flex-start; background: var(--incoming-msg); }
.msg.sent { align-self: flex-end; background: var(--outgoing-msg); }

.sender-name { font-weight: bold; color: var(--accent); font-size: 0.85rem; display: block; margin-bottom: 2px; }
.msg-text { word-wrap: break-word; }
.msg-time { font-size: 0.7rem; color: var(--text-secondary); float: right; margin-top: 5px; margin-left: 8px; }

.system-msg { align-self: center; background: #182229; color: #ffd279; font-size: 0.8rem; padding: 5px 15px; border-radius: 5px; margin: 10px 0; text-align: center; max-width: 80%; }
